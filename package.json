{
    "name": "s2j-webinar",
    "version": "0.0.1",
    "description": "A companion plugin for GatherPress that adds a webinar request feature",
    "type": "module",
    "author": "Koutarou ISHIKAWA",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stein2nd/s2j-webinar.git"
    },
    "homepage": "https://github.com/stein2nd/s2j-webinar#readme",
    "bugs": {
        "url": "https://github.com/stein2nd/s2j-webinar/issues"
    },
    "keywords": [
        "wordpress",
        "plugin",
        "gutenberg",
        "blocks",
        "management",
        "webinar"
    ],
    "main": "s2j-webinar.php",
    "scripts": {
        "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md",
        "lint": "npm run lint:ts && npm run lint:scss",
        "lint:fix": "npm run lint:ts:fix && npm run lint:scss:fix",
        "lint:ts": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx",
        "lint:ts:fix": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx --fix",
        "lint:scss": "stylelint src/**/*.scss",
        "lint:scss:fix": "stylelint src/**/*.scss --fix",
        "lint:php": "composer lint:php",
        "phpstan": "composer phpstan",
        "phpcs": "composer phpcs",
        "phpcs:wpcs": "composer phpcs:wpcs",
        "test:smoke:local": "bash tests/smoke-local.sh",
        "test:unit:php": "wp-env run tests-wordpress wp-content/plugins/s2j-webinar/vendor/bin/phpunit -c wp-content/plugins/s2j-webinar/phpunit.wp-env.xml.dist",
        "test:unit:php:unit-only": "composer test:unit",
        "test:unit:php:local": "bash bin/phpunit-local.sh",
        "build:dev": "FLUSH_DIST=true npm run build:dev:admin && npm run build:dev:gutenberg && npm run build:dev:classic && npm run build:dev:frontend",
        "build:production": "FLUSH_DIST=true npm run build:production:admin && npm run build:production:gutenberg && npm run build:production:classic && npm run build:production:frontend",
        "makepot": "wp i18n make-pot . languages/s2j-webinar.pot --domain=s2j-webinar",
        "makemo": "wp i18n make-mo languages",
        "makejson": "wp i18n make-json languages",
        "makejson:keep": "wp i18n make-json languages --no-purge",
        "makei18n": "npm run makemo && npm run makejson",
        "dist:build": "npm run build:production",
        "dist:zip": "node tools/dist/make-dist-zip.mjs",
        "dist": "npm run dist:build && npm run dist:zip",
        "build:dev:admin": "NODE_ENV=development FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
        "build:dev:gutenberg": "NODE_ENV=development FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
        "build:dev:classic": "NODE_ENV=development FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
        "build:dev:frontend": "NODE_ENV=development FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
        "build:production:admin": "NODE_ENV=production FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
        "build:production:gutenberg": "NODE_ENV=production FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
        "build:production:classic": "NODE_ENV=production FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
        "build:production:frontend": "NODE_ENV=production FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
        "dev": "vite build --mode development --watch",
        "wp-env": "wp-env",
        "pretest:phpunit": "composer install --no-interaction --prefer-dist",
        "phpunit": "composer test",
        "phpunit:local": "vendor/bin/phpunit -c phpunit.unit.xml.dist",
        "prephpunit:wp-env": "composer install --no-interaction --prefer-dist",
        "phpunit:wp-env": "npm run test:unit:php",
        "pretest:unit:php": "wp-env start",
        "pretest:unit:php:local": "composer install --no-interaction --prefer-dist",
        "pretest:unit:php:unit-only": "composer install --no-interaction --prefer-dist",
        "pretest:lint:php": "composer install --no-interaction --prefer-dist",
        "postbuild:production:gutenberg": "npm run makejson"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "overrides": {
        "rollup": "^4.65.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@s2j/docs-linter": "^1.0.30",
        "@types/jquery": "^4.0.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@wordpress/api-fetch": "^8.0.0",
        "@wordpress/block-editor": "^19.0.0",
        "@wordpress/blocks": "^17.0.0",
        "@wordpress/components": "^43.0.0",
        "@wordpress/core-data": "^9.0.0",
        "@wordpress/data": "^11.0.0",
        "@wordpress/element": "^10.0.0",
        "@wordpress/env": "^12.0.0",
        "@wordpress/i18n": "^7.0.0",
        "@wordpress/plugins": "^8.0.0",
        "@wordpress/url": "^5.0.0",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.13.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "rollup": "^4.65.0",
        "sass": "^1.106.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.5",
        "vite-plugin-static-copy": "^4.1.1"
    },
    "allowScripts": {
        "@s2j/docs-linter": true,
        "fsevents": true,
        "@parcel/watcher": true
    }
}
