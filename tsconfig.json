{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./src/*"],
			"@wordpress/block-editor": ["./src/types/shims/wordpress-block-editor.d.ts"],
			"@wordpress/data": ["./src/types/shims/wordpress-data.d.ts"],
			"@wordpress/edit-post": ["./src/types/shims/wordpress-edit-post.d.ts"],
			"@wordpress/editor": ["./src/types/shims/wordpress-editor.d.ts"]
		},
		"types": ["@types/react", "@types/react-dom"]
	},
	"include": ["src/**/*", "vite.config.ts"],
	"exclude": ["node_modules", "dist"]
}
