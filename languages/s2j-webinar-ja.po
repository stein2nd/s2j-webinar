msgid "S2J Webinar"
msgstr "S2J Webinar"

#. Plugin URI of the plugin
#: s2j-webinar.php
msgid "https://github.com/stein2nd/s2j-webinar"
msgstr "https://github.com/stein2nd/s2j-webinar"

#. Description of the plugin
#: s2j-webinar.php
msgid "Create and sync Webinars from GatherPress event editing screens."
msgstr "GatherPressのイベント編集画面からウェビナーを作成・同期できます。"

#. Author of the plugin
#: s2j-webinar.php
msgid "Koutarou ISHIKAWA"
msgstr "Koutarou ISHIKAWA"

#. Author URI of the plugin
#: s2j-webinar.php
msgid "https://stein2nd.wordpress.com"
msgstr "https://stein2nd.wordpress.com"

#: includes/Admin/PluginListIcon.php:48
msgid "Settings"
msgstr "設定"

#. translators: %s: webinar provider name, e.g. Zoom
#: includes/Admin/SettingsPage.php:124
#, php-format
msgid "Connect %s"
msgstr "%s に接続"

#: includes/Admin/SettingsPage.php:168
#: includes/OAuth/OAuthFlow.php:41
#: includes/OAuth/OAuthFlow.php:58
#: includes/OAuth/OAuthFlow.php:69
msgid "Forbidden"
msgstr "禁止"

#: includes/Admin/SettingsPage.php:191
msgid "Settings saved."
msgstr "設定が保存されました。"

#. translators: %s: webinar provider name, e.g. Zoom
#: includes/Admin/SettingsPage.php:214
#, php-format
msgid "%s account connected."
msgstr "%s アカウントに接続しました。"

#. translators: %s: webinar provider name, e.g. Zoom
#: includes/Admin/SettingsPage.php:219
#, php-format
msgid "%s connection removed."
msgstr "%s 接続を解除しました。"

#: includes/Admin/SettingsPage.php:222
msgid "Enter Client ID and Client Secret before connecting."
msgstr "接続する前に、クライアント ID と秘密鍵を入力してください。"

#. translators: %s: webinar provider name, e.g. Zoom
#: includes/Admin/SettingsPage.php:225
#, php-format
msgid "%s authorization was not completed."
msgstr "%s の認可が完了しませんでした。"

#: includes/Admin/SettingsPage.php:228
msgid "Could not exchange the authorization code. Check credentials and redirect URL."
msgstr "認証コードを交換できませんでした。認証情報とリダイレクトURLを確認してください。"

#: includes/Admin/SettingsPage.php:279
#: includes/Admin/SettingsPage.php:362
msgid "Save settings"
msgstr "設定を保存"

#: includes/Admin/SettingsPage.php:283
#: dist/js/s2j-webinar-settings.js:1
msgid "S2J Webinar settings are saved above. Event panel controls load in the block editor."
msgstr "S2J Webinar 設定は上記に保存されています。イベントパネルのコントロールはブロックエディタにロードされます。"

#: includes/Admin/SettingsPage.php:367
msgid "Disconnect"
msgstr "接続を解除"

#. translators: 1: webinar provider name, 2: opening anchor tag, 3: closing anchor tag
#: includes/Admin/SettingsPage.php:398
#, php-format
msgid "Where to find each value in the %1$s developer console: %2$sProvider setup guide%3$s."
msgstr "%1$s の開発者コンソールで各項目をどこで取得・設定するか: %2$sプロバイダー設定ガイド%3$s。"

#: includes/Admin/SettingsPage.php:416
msgid "Which webinar platform this site uses. Additional providers may be selectable here in a future release."
msgstr "当サイトが利用しているウェビナープラットフォームです。今後のリリースでは、ここで他のプロバイダーも選択できるようになる可能性があります。"

#: includes/Admin/SettingsPage.php:421
msgid "Webinar provider"
msgstr "ウェビナープロバイダー"

#: includes/Admin/SettingsPage.php:432
msgid "Client ID"
msgstr "クライアント ID"

#. translators: 1: webinar provider name, 2: same as 1 when users click Connect
#: includes/Admin/SettingsPage.php:435
#, php-format
msgid "From your %1$s OAuth app (General app). Identifies this WordPress site to %2$s when users click Connect."
msgstr "%1$s OAuth アプリケーション (General app) の値です。ユーザーが「接続」をクリックした際、この WordPress サイトを %2$s に対して識別させます。"

#: includes/Admin/SettingsPage.php:443
msgid "Client Secret"
msgstr "クライアント秘密鍵"

#: includes/Admin/SettingsPage.php:444
msgid "Proves your site owns the OAuth app. Stored encrypted in the database; leave blank to keep the saved secret."
msgstr "サイトがOAuthアプリを所有していることを証明します。データベースに暗号化されて保存されます; 空欄のままであれば、保存済みの秘密鍵が保持されます。"

#: includes/Admin/SettingsPage.php:448
msgid "Redirect URI"
msgstr "リダイレクト URI"

#. translators: 1: webinar provider name, 2: same as 1 after users approve access
#: includes/Admin/SettingsPage.php:451
#, php-format
msgid "Add this exact URL to your %1$s app’s Redirect URL allow list. %2$s sends users back here after they approve access."
msgstr "この正規の URL を、%1$s アプリケーションの「リダイレクト URL の許可リスト」に追加してください。ユーザーがアクセスを承認すると、%2$s からこの URL にリダイレクトされます。"

#: includes/Admin/SettingsPage.php:459
msgid "Webhook secret"
msgstr "Webhook の秘密鍵"

#. translators: 1: webinar provider name, 2: same as 1 for webhook origin
#: includes/Admin/SettingsPage.php:462
#, php-format
msgid "From %1$s Event Subscriptions. Used to verify that started/ended notifications really come from %2$s."
msgstr "%1$s イベント・サブスクリプションの値です。開始/終了通知が実際に %2$s から送信されていることを確認するために使用されます。"

#: includes/Admin/SettingsPage.php:470
msgid "Webhook URL"
msgstr "Webhook URL"

#. translators: 1: webinar provider name, 2: same as 1 for notifications
#: includes/Admin/SettingsPage.php:473
#, php-format
msgid "Paste into %1$s Event Subscriptions endpoint URL so %2$s can notify this site when a webinar starts or ends."
msgstr "%1$s イベントサブスクリプションのエンドポイント URL にペーストして、ウェビナーの開始または終了時に %2$s からこのサイトに通知が届くようにしてください。"

#: includes/Admin/SettingsPage.php:484
msgid "Show Webinar tab in GatherPress Settings"
msgstr "GatherPress 設定に「ウェビナー」タブを表示"

#: includes/Admin/SettingsPage.php:485
msgid "When enabled, a Webinar tab appears near Tools and Alpha under GatherPress Settings."
msgstr "有効にすると、GatherPressの設定画面の「ツール」と「Alpha」の近くに「ウェビナー」タブが表示されます。"

#: includes/Admin/SettingsPage.php:492
msgid "Enabled"
msgstr "有効"

#: includes/Admin/SettingsPage.php:506
msgid "GatherPress"
msgstr "GatherPress"

#: includes/Admin/SettingsPage.php:512
msgid "GatherPress plugin: active"
msgstr "GatherPress プラグイン: 有効"

#: includes/Admin/SettingsPage.php:513
msgid "GatherPress plugin: not active — install and activate GatherPress to edit webinars on events."
msgstr "GatherPress プラグイン: 無効 — イベントのウェビナーを編集するには、GatherPress をインストールして有効化してください。"

#: includes/Admin/SettingsPage.php:521
msgid "Event post type: available"
msgstr "イベント投稿タイプ: 利用可能"

#: includes/Admin/SettingsPage.php:522
msgid "Event post type: not found — check GatherPress activation."
msgstr "イベント投稿タイプ: 見つかりません — GatherPress が有効になっているか確認してください。"

#: includes/Admin/SettingsPage.php:530
msgid "GatherPress alpha: active (companion for current GatherPress releases)"
msgstr "GatherPress alpha: 有効 (現在の GatherPress 向けコンパニオン)"

#: includes/Admin/SettingsPage.php:531
msgid "GatherPress alpha: not active — wp.org GatherPress may require the alpha companion plugin."
msgstr "GatherPress alpha: 無効 — WordPress.org 版 GatherPress では alpha コンパニオンが必要な場合があります。"

#: includes/Admin/SettingsPage.php:539
msgid "Open GatherPress Settings → Webinar tab"
msgstr "GatherPress 設定 → Webinar タブを開く"

#: includes/Admin/SettingsPage.php:550
msgid "Authorize once so editors can sync webinars from GatherPress events. Tokens stay on the server; editors never see secrets."
msgstr "一度認証を行うことで、編集者はGatherPressのイベントからウェビナーを同期できるようになります。トークンはサーバー上に保存され、編集者が秘密鍵を目にすることはありません。"

#: includes/Admin/SettingsPage.php:554
msgid "Connection status"
msgstr "接続状態"

#: includes/Admin/SettingsPage.php:558
msgid "Status: connected"
msgstr "状態: 接続済み"

#. translators: %s: provider account email
#: includes/Admin/SettingsPage.php:563
#, php-format
msgid "Account: %s"
msgstr "アカウント: %s"

#. translators: %s: connect button label, e.g. Connect Zoom
#: includes/Admin/SettingsPage.php:571
#, php-format
msgid "Status: not connected — save Client ID/Secret, then click %s."
msgstr "状態: 未接続 — クライアント ID/秘密鍵を保存してから、%s をクリックしてください。"

#: includes/GatherPress/SettingsTab.php:43
msgid "Webinar"
msgstr "ウェビナー"

#: includes/GatherPress/SettingsTab.php:47
msgid "Webinar connection"
msgstr "ウェビナー接続"

#: includes/GatherPress/SettingsTab.php:48
msgid "Site-wide OAuth credentials, webhooks, and connection for event webinars."
msgstr "サイト全体の OAuth 認証情報、Webhook、およびイベントウェビナーへの接続設定です。"

#: includes/Messages/DeficiencyMessages.php:34
msgid "Event title is required."
msgstr "イベントタイトルは必須です。"

#: includes/Messages/DeficiencyMessages.php:35
msgid "Event start date and time are required."
msgstr "イベントの開始日時は必須です。"

#: includes/Messages/DeficiencyMessages.php:36
msgid "Event timezone is required."
msgstr "イベントのタイムゾーンは必須です。"

#: includes/Messages/DeficiencyMessages.php:37
msgid "Event duration must be at least one minute."
msgstr "イベントの所要時間は、少なくとも1分以上が必要です。"

#: includes/Messages/DeficiencyMessages.php:38
msgid "Add at least one panelist before syncing."
msgstr "同期する前に、パネリストを少なくとも1人追加してください。"

#: includes/Messages/DeficiencyMessages.php:39
msgid "Each panelist needs a valid email address."
msgstr "各パネリストには、有効なメールアドレスが必要です。"

#: includes/Messages/DeficiencyMessages.php:40
msgid "A panelist email address is invalid."
msgstr "パネリストのメールアドレスが不正です。"

#. translators: %s: webinar provider name, e.g. Zoom
#: includes/Messages/DeficiencyMessages.php:43
#, php-format
msgid "This event is not linked to a %s webinar yet."
msgstr "このイベントは、まだ %s ウェビナーにリンクされていません。"

#: includes/Messages/DeficiencyMessages.php:46
msgid "This provider is not supported."
msgstr "このプロバイダーは、サポートされていません。"

#. translators: %s: webinar provider name, e.g. Zoom
#: includes/Messages/DeficiencyMessages.php:55
#, php-format
msgid "Could not sync. Check event fields and %s connection."
msgstr "同期できませんでした。イベント項目と %s 接続を確認してください。"

#: includes/Plugin.php:71
msgid "S2J Webinar: Composer dependencies are missing. Run composer install in the plugin directory."
msgstr "S2J Webinar: Composer の依存関係が不足しています。プラグインのディレクトリで「composer install」を実行してください。"

