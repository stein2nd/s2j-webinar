{
    "intelephense.environment.includePaths": [
        "${workspaceFolder}/includes",
        "${workspaceFolder}/stubs",
        "${workspaceFolder}/vendor",
        "${workspaceFolder}/vendor/php-stubs/wordpress-stubs"
    ],
    "intelephense.stubs": [
        "wordpress",
        "wordpress-globals",
        "Core",
        "standard",
        "hash",
        "json",
        "curl",
        "dom",
        "mbstring",
        "SPL",
        "libxml"
    ],
    "php.stubs": [
        "*",
        "wordpress",
        "${workspaceFolder}/stubs/gatherpress.php",
        "${workspaceFolder}/stubs/s2j-webinar-plugin.php",
        "${workspaceFolder}/stubs/php-internal.php",
        "${workspaceFolder}/stubs/wordpress-tests.php"
    ],
    "json.schemaDownload.enable": true,
    "textlint.configPath": "${workspaceFolder}/.textlintrc.json",
    "textlint.nodePath": "${workspaceFolder}/node_modules",
    "textlint.autoFixOnSave": true,
    "textlint.enable": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.textlint": "always"
    },
    "[markdown]": {
      "editor.defaultFormatter": "3w36zj6.textlint"
    }
  }
  